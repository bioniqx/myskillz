{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "permissions": {
    "allow": [
      "Bash(git:*)"
    ],
    "deny": [
      "Bash(git push:*)"
    ]
  },
  "model": "opencode/deepseek-v4-flash-free",
  "skillOverrides": {
    "find-skills": "off",
    "grill-me": "off",
    "grill-with-docs": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(jq -r '.tool_input.command // empty'); if printf '%s' \"$CMD\" | grep -Eq '(^|[^[:alnum:]_])git[[:space:]]+push([^[:alnum:]_]|$)'; then printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"git push bi chan theo cau hinh he thong (~/.claude/settings.json). git commit va cac lenh git khac deu duoc phep.\"}}'; else exit 0; fi"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "coderabbit@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "handoff@handoff": true,
    "insecure-defaults@trailofbits": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "skill-improver@trailofbits": true,
    "static-analysis@trailofbits": false,
    "superpowers@claude-plugins-official": false,
    "workflow-skill-design@trailofbits": true
  },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/addyosmani/agent-skills.git"
      }
    },
    "handoff": {
      "source": {
        "source": "github",
        "repo": "thepushkarp/handoff"
      }
    },
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills"
      }
    }
  },
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "normal",
  "preferredNotifChannel": "iterm2_with_bell",
  "autoCompactEnabled": true,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
